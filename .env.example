# -----------------------------------------------------------------
# Trilha Formativa de Inovação — API
# Copie este arquivo para .env e ajuste os valores do seu ambiente.
# O .env NÃO deve ser versionado.
# -----------------------------------------------------------------

# Identificação da aplicação
APP_NAME="Trilha Formativa de Inovação"

# Endereço público do frontend. Usado para montar o link de
# redefinição de senha enviado por e-mail. Nunca derive esse endereço
# do cabeçalho Host da requisição: seria uma porta aberta para Host
# Header Injection.
APP_FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------
# Autenticação (JWT)
# -----------------------------------------------------------------
JWT_SECRET=sua_chave_secreta
JWT_EXPIRATION=28800

# -----------------------------------------------------------------
# Recuperação de senha
# -----------------------------------------------------------------
# Validade do token de redefinição, em minutos.
PASSWORD_RESET_TTL_MINUTES=30

# Rate limiting por conta: no máximo N solicitações dentro da janela.
PASSWORD_RESET_MAX_REQUESTS=3
PASSWORD_RESET_WINDOW_MINUTES=15

# -----------------------------------------------------------------
# Envio de e-mail (SMTP / PHPMailer)
# -----------------------------------------------------------------
MAIL_HOST=smtp.seu-provedor.com
MAIL_PORT=587

# Deixe MAIL_USERNAME vazio para SMTP sem autenticação.
MAIL_USERNAME=usuario@seu-dominio.com
MAIL_PASSWORD=sua_senha_de_aplicativo

# tls (STARTTLS, porta 587) | ssl (SMTPS, porta 465) | vazio (sem criptografia)
MAIL_ENCRYPTION=tls

MAIL_FROM_ADDRESS=nao-responda@seu-dominio.com
MAIL_FROM_NAME="Trilha Formativa de Inovação"

# 0 = silencioso, 2 = mostra o diálogo SMTP. Use apenas em desenvolvimento.
MAIL_SMTP_DEBUG=0
